@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap');

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: #080d19;
  color: #fff;
  font-family: Inter, sans-serif;
}

button {
  cursor: pointer;
  font-family: inherit;
  color: inherit;
}

#app {
  width: 100%;
  min-height: 100vh;
  margin: auto;
}

.game {
  max-width: 480px;
  min-height: 100vh;
  margin: auto;
  padding: 14px;
  background: linear-gradient(180deg,#101b31,#080d19 55%);
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px;
  border: 1px solid #263b5e;
  border-radius: 13px;
  background: #14213a;
}

.brand {
  display: flex;
  align-items: center;
  gap: 9px;
  font-family: Orbitron,sans-serif;
  font-size: 17px;
  font-weight: 800;
}

.brand-icon {
  font-size: 25px;
}

.wallet {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 7px 10px;
  border-radius: 9px;
  background: #0a1427;
  color: #41e6a0;
}

.wallet button {
  border: none;
  background: transparent;
  font-size: 21px;
}

.history-strip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 13px 0;
  padding: 11px;
  background: #14213a;
  border: 1px solid #263b5e;
  border-radius: 10px;
  font-size: 11px;
  color: #b6c8e8;
  overflow: hidden;
}

#recentResults {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

#historyBtn {
  border: none;
  background: #263b5e;
  border-radius: 7px;
  padding: 6px 10px;
}

.battle {
  padding: 17px 12px;
  text-align: center;
  border: 1px solid #354d77;
  border-radius: 16px;
  background: radial-gradient(circle at center,#1d3155,#101b31 70%);
  box-shadow: 0 0 25px #142b5030;
}

.round {
  color: #9eb5d8;
  font-size: 11px;
  letter-spacing: 2px;
}

.fighters {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: 20px 0;
}

.fighter {
  width: 39%;
  padding: 13px 5px;
  border-radius: 13px;
}

.pulse {
  border: 1px solid #168aff;
  background: #0879ff18;
  box-shadow: 0 0 20px #168aff25;
}

.blade {
  border: 1px solid #ff3c55;
  background: #ff243d18;
  box-shadow: 0 0 20px #ff243d25;
}

.fighter-icon {
  font-size: 40px;
  animation: fight 1s infinite alternate;
}

@keyframes fight {
  from { transform: translateY(-5px) scale(1); }
  to { transform: translateY(5px) scale(1.08); }
}

.fighter h2 {
  margin: 7px 0;
  font-family: Orbitron,sans-serif;
  font-size: 13px;
}

.pulse h2 { color: #45aaff; }
.blade h2 { color: #ff6879; }

.number {
  font-family: Orbitron,sans-serif;
  font-size: 29px;
  font-weight: 800;
}

.versus {
  font-family: Orbitron,sans-serif;
  font-size: 14px;
  color: #ffd36b;
}

.timer {
  font-family: Orbitron,sans-serif;
  font-size: 32px;
  font-weight: 800;
  color: #ffd36b;
}

.battle-status {
  margin-top: 5px;
  font-size: 10px;
  letter-spacing: 2px;
  color: #9eb5d8;
}

.bet-section {
  margin-top: 16px;
  padding: 13px;
  background: #14213a;
  border: 1px solid #263b5e;
  border-radius: 12px;
}

.bet-section h3,
.amount-section h3 {
  margin-bottom: 12px;
  color: #a9bddf;
  font-family: Orbitron,sans-serif;
  font-size: 11px;
  letter-spacing: 1px;
}

.bet-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
}

.bet-option {
  position: relative;
  min-height: 48px;
  padding: 10px 7px;
  border: 1px solid #344a6d;
  border-radius: 9px;
  background: #0d192e;
  font-weight: 700;
  font-size: 12px;
  transition: .2s;
}

.bet-option span {
  margin-left: 5px;
  color: #ffd36b;
  font-size: 10px;
}

.bet-option b {
  display: block;
  margin-top: 4px;
  color: #45e7a0;
  font-size: 11px;
}

.bet-option.selected {
  border: 2px solid #36e6a0;
  background: #124b3b;
  box-shadow: 0 0 13px #36e6a044;
}

.number-grid {
  display: grid;
  grid-template-columns: repeat(5,1fr);
  gap: 8px;
}

.number-grid .bet-option {
  min-height: 54px;
  font-family: Orbitron,sans-serif;
  font-size: 17px;
}

.number-grid small {
  display: block;
  color: #ffd36b;
  font-size: 9px;
}

.confirm-bar {
  display: none;
  align-items: center;
  gap: 9px;
  margin-top: 13px;
  padding: 7px 9px;
  border: 1px solid #3e987a;
  border-radius: 8px;
  background: #123d35;
  font-size: 11px;
}

.confirm-bar span { flex: 1; }

.confirm-bar button {
  width: 29px;
  height: 27px;
  border: none;
  border-radius: 6px;
  font-size: 17px;
  font-weight: 800;
}

#cancelBet { background: #a92e40; }
#confirmBet { background: #13875e; }

.amount-section {
  margin-top: 16px;
  padding: 14px;
  background: #14213a;
  border: 1px solid #263b5e;
  border-radius: 12px;
}

.amount-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 9px;
}

.amount-btn {
  padding: 12px 5px;
  border: 1px solid #405779;
  border-radius: 9px;
  background: #0b172c;
  font-weight: 800;
  font-size: 13px;
  transition: .2s;
}

.amount-btn.active {
  border: 2px solid #ffd36b;
  color: #ffd36b;
  background: #40351c;
  transform: translateY(-3px);
  box-shadow: 0 5px 12px #0006;
}

.modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 10;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: #000b;
}

.modal-content {
  position: relative;
  width: 100%;
  max-width: 400px;
  padding: 25px;
  border: 1px solid #405779;
  border-radius: 14px;
  background: #14213a;
}

.modal-content h2 {
  margin-bottom: 14px;
  color: #ffd36b;
  font-family: Orbitron,sans-serif;
  font-size: 17px;
}

.modal-content p {
  color: #c0cee4;
  font-size: 13px;
  line-height: 1.7;
}

#closeModal {
  position: absolute;
  top: 10px;
  right: 12px;
  border: none;
  background: transparent;
  font-size: 20px;
}

@media(max-width:350px) {
  .game { padding: 8px; }
  .brand { font-size: 14px; }
}

/* LIVE PULSE VS BLADE FIGHT */
.battle {
  position: relative;
  overflow: hidden;
}

.battle.fighting .fighters {
  animation: arena-shake 2.2s infinite;
}

.battle.fighting .pulse .fighter-icon {
  animation: pulse-attack 1.15s infinite ease-in-out;
}

.battle.fighting .blade .fighter-icon {
  animation: blade-attack 1.15s infinite ease-in-out;
}

.battle.fighting .pulse {
  animation: pulse-glow 1.15s infinite alternate;
}

.battle.fighting .blade {
  animation: blade-glow 1.15s infinite alternate;
}

@keyframes pulse-attack {
  0%, 100% { transform: translateX(0) rotate(0) scale(1); }
  35% { transform: translateX(24px) rotate(20deg) scale(1.25); }
  50% { transform: translateX(29px) rotate(28deg) scale(1.3); }
  70% { transform: translateX(-3px) rotate(-8deg) scale(1); }
}

@keyframes blade-attack {
  0%, 100% { transform: translateX(0) rotate(0) scale(1); }
  35% { transform: translateX(-24px) rotate(-20deg) scale(1.25); }
  50% { transform: translateX(-29px) rotate(-28deg) scale(1.3); }
  70% { transform: translateX(3px) rotate(8deg) scale(1); }
}

@keyframes pulse-glow {
  from { box-shadow: 0 0 8px #168aff25; }
  to { box-shadow: 0 0 25px #168affaa; }
}

@keyframes blade-glow {
  from { box-shadow: 0 0 8px #ff243d25; }
  to { box-shadow: 0 0 25px #ff243daa; }
}

@keyframes arena-shake {
  0%, 42%, 48%, 100% { transform: translateX(0); }
  44% { transform: translateX(-3px); }
  46% { transform: translateX(3px); }
}

.battle.fighting::after {
  content: '✦';
  position: absolute;
  left: 50%;
  top: 48%;
  color: #fff2a6;
  font-size: 24px;
  opacity: 0;
  pointer-events: none;
  animation: clash-spark 1.15s infinite;
}

@keyframes clash-spark {
  0%, 35%, 70%, 100% { opacity: 0; transform: translate(-50%,-50%) scale(.2) rotate(0); }
  45%, 55% { opacity: 1; transform: translate(-50%,-50%) scale(1.7) rotate(90deg); }
}

.timer-ending {
  color: #ff596b;
  animation: timer-pulse .5s infinite alternate;
}

@keyframes timer-pulse {
  to { transform: scale(1.15); text-shadow: 0 0 15px #ff334f; }
}

.battle-finish .fighter-icon {
  animation: finish-pop .5s ease;
}

@keyframes finish-pop {
  50% { transform: scale(1.4); }
}

.flight-layer {
  position: fixed;
  inset: 0;
  z-index: 100;
  pointer-events: none;
  overflow: hidden;
}

.flying-coin {
  position: fixed;
  z-index: 101;
  font-size: 23px;
  pointer-events: none;
  animation: coin-flight .85s cubic-bezier(.2,.75,.25,1) forwards;
  filter: drop-shadow(0 0 7px #ffd34b);
}

.flying-coin.returning {
  animation-duration: .95s;
}

@keyframes coin-flight {
  0% { transform: translate(0,0) scale(.55) rotate(0); opacity: 0; }
  12% { opacity: 1; transform: translate(0,0) scale(1.25) rotate(30deg); }
  75% { opacity: 1; }
  100% {
    transform: translate(var(--move-x),var(--move-y)) scale(.45) rotate(300deg);
    opacity: 0;
  }
}

.reward-float {
  position: fixed;
  z-index: 102;
  color: #45f0a0;
  font-family: Orbitron, sans-serif;
  font-weight: 800;
  font-size: 16px;
  white-space: nowrap;
  text-shadow: 0 0 12px #18e99b;
  pointer-events: none;
  animation: reward-rise 1.35s ease-out forwards;
}

@keyframes reward-rise {
  0% { opacity: 0; transform: translateY(12px) scale(.7); }
  20% { opacity: 1; transform: translateY(0) scale(1.15); }
  100% { opacity: 0; transform: translateY(-48px) scale(1); }
}

.winner-flash {
  animation: winner-flash .8s ease 3;
}

@keyframes winner-flash {
  50% { box-shadow: 0 0 22px #35f0a0; border-color: #35f0a0; }
}

.game-toast {
  position: fixed;
  z-index: 200;
  top: 18px;
  left: 50%;
  transform: translateX(-50%);
  padding: 12px 18px;
  border: 1px solid #3ce5a1;
  border-radius: 10px;
  background: #123d35;
  color: #65ffc0;
  font-size: 12px;
  font-weight: 800;
  text-align: center;
  box-shadow: 0 5px 25px #0008;
  animation: toast-in .25s ease-out;
}

@keyframes toast-in {
  from { opacity: 0; transform: translate(-50%,-15px); }
  to { opacity: 1; transform: translate(-50%,0); }
}

.bet-option:disabled {
  cursor: not-allowed;
  opacity: .65;
}

/* ARMORED SWORD WARRIORS */
.warrior-svg {
  width: 100px;
  height: 125px;
  overflow: visible;
  display: block;
  margin: 0 auto 5px;
  color: url(#armorBlue);
  filter: drop-shadow(0 0 9px currentColor);
}

.pulse .warrior-svg {
  color: #168aff;
}

.blade .warrior-svg {
  color: #ff344d;
  transform: scaleX(-1);
}

.pulse .warrior-body {
  fill: url(#armorBlue);
}

.blade .warrior-body {
  fill: url(#armorRed);
}

.battle.fighting .pulse .warrior-body {
  animation: blue-warrior-charge 1.3s infinite ease-in-out;
  transform-origin: center;
}

.battle.fighting .blade .warrior-body {
  animation: red-warrior-charge 1.3s infinite ease-in-out;
  transform-origin: center;
}

.battle.fighting .pulse .warrior-sword {
  transform-box: fill-box;
  transform-origin: 50% 90%;
  animation: blue-sword-swing 1.3s infinite ease-in-out;
}

.battle.fighting .blade .warrior-sword {
  transform-box: fill-box;
  transform-origin: 50% 90%;
  animation: red-sword-swing 1.3s infinite ease-in-out;
}

@keyframes blue-warrior-charge {
  0%,100% { transform: translateX(0) rotate(0); }
  35%,55% { transform: translateX(13px) rotate(8deg); }
  70% { transform: translateX(-3px); }
}

@keyframes red-warrior-charge {
  0%,100% { transform: translateX(0) rotate(0); }
  35%,55% { transform: translateX(-13px) rotate(-8deg); }
  70% { transform: translateX(3px); }
}

@keyframes blue-sword-swing {
  0%,100% { transform: rotate(0); }
  35%,55% { transform: rotate(-65deg); }
  70% { transform: rotate(20deg); }
}

@keyframes red-sword-swing {
  0%,100% { transform: rotate(0); }
  35%,55% { transform: rotate(65deg); }
  70% { transform: rotate(-20deg); }
}

@media(max-width:380px) {
  .warrior-svg {
    width: 78px;
    height: 105px;
  }
}

.arena3d {
  width: 100%;
  height: 260px;
  margin: 14px auto;
  overflow: hidden;
  border: 1px solid #31527c;
  border-radius: 14px;
  background: #080d19;
  box-shadow: inset 0 0 25px #168aff22, 0 0 20px #0008;
}

.arena3d canvas {
  display: block;
  width: 100%;
  height: 100%;
}

@media(max-width:380px) {
  .arena3d { height: 220px; }
}

.arena-wrap { position: relative; width: 100%; }
.arena-results {
  position: absolute; z-index: 5; top: 8px; left: 0; right: 0;
  display: flex; justify-content: space-between; padding: 0 12px;
  pointer-events: none;
}
.arena-results > div {
  padding: 6px 12px; border-radius: 9px;
  background: rgba(8,12,25,.85); font-size: 11px; font-weight: 800;
  color: #fff; border: 1px solid #ffffff30;
}
.result-pulse { box-shadow: 0 0 12px #168cff55; }
.result-blade { box-shadow: 0 0 12px #ff344455; }
.arena-results span { display: inline-block; margin-left: 5px; font-size: 16px; }
